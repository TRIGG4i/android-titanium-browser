+    private static Set<String> readEnhancedDesktopHosts() {
+        String encoded =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.ENHANCED_DESKTOP_SITE_HOSTS, "");
+        Set<String> hosts = new TreeSet<>();
+        if (!TextUtils.isEmpty(encoded)) {
+            Collections.addAll(hosts, encoded.split(","));
+        }
+        return hosts;
