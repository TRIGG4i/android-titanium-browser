+    /** Returns whether the URL should use Titanium's coherent enhanced desktop profile. */
+    public static boolean shouldUseEnhancedDesktopSite(@Nullable GURL url) {
+        if (url == null || !url.isValid() || TextUtils.isEmpty(url.getHost())) return false;
+        if (isZoomEnhancedDesktopUrl(url)) return true;
+        return readEnhancedDesktopHosts().contains(url.getHost().toLowerCase(Locale.ROOT));
+    }
+
+    /** Persists the enhanced desktop profile for the exact host of {@code url}. */
+    public static void setEnhancedDesktopSiteForUrl(GURL url, boolean enabled) {
+        if (!url.isValid() || TextUtils.isEmpty(url.getHost())) return;
+        Set<String> hosts = readEnhancedDesktopHosts();
+        String host = url.getHost().toLowerCase(Locale.ROOT);
+        if (enabled) {
+            hosts.add(host);
+        } else {
+            hosts.remove(host);
+        }
+        ChromeSharedPreferences.getInstance()
+                .writeString(
+                        ChromePreferenceKeys.ENHANCED_DESKTOP_SITE_HOSTS,
+                        TextUtils.join(",", hosts));
+    }
