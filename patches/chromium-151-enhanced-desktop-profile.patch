+namespace {
+
+constexpr char kEnhancedDesktopHostsPreference[] =
+    "Chrome.Titanium.EnhancedDesktopSiteHosts";
+
+bool IsHostOrSubdomain(std::string_view host, std::string_view domain) {
+  return host == domain ||
+         (host.size() > domain.size() &&
+          host[host.size() - domain.size() - 1] == '.' &&
+          host.substr(host.size() - domain.size()) == domain);
+}
+
+bool IsZoomEnhancedDesktopUrl(const GURL& url) {
+  std::string host = base::ToLowerASCII(url.host());
+  if (IsHostOrSubdomain(host, "marketplace.zoom.us") ||
+      IsHostOrSubdomain(host, "e.zoom.us") ||
+      IsHostOrSubdomain(host, "developers.zoom.us") ||
+      IsHostOrSubdomain(host, "marketplacefront-cf.zoom.us") ||
+      IsHostOrSubdomain(host, "marketplacecontent-cf.zoom.us") ||
+      IsHostOrSubdomain(host, "vaapplicationscontent.zoom.us")) {
+    return true;
+  }
+  return host == "zoom.us" &&
+         (url.path_piece().starts_with("/signin") ||
+          url.path_piece().starts_with("/oauth") ||
+          url.path_piece().starts_with("/account"));
+}
+
+bool ShouldUseEnhancedDesktopProfile(const GURL& url) {
+  if (IsZoomEnhancedDesktopUrl(url)) {
+    return true;
+  }
+  base::android::SharedPreferencesManager shared_prefs =
+      android::shared_preferences::GetChromeSharedPreferences();
+  std::vector<std::string> hosts = base::SplitString(
+      shared_prefs.ReadString(kEnhancedDesktopHostsPreference, std::string()),
+      ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::string host = base::ToLowerASCII(url.host());
+  return std::ranges::find(hosts, host) != hosts.end();
+}
+
+blink::UserAgentOverride BuildDesktopUserAgentOverride(bool enhanced_desktop) {
+  constexpr char kLinuxInfoStr[] = "X11; Linux x86_64";
+  constexpr char kWindowsInfoStr[] = "Windows NT 10.0; Win64; x64";
+  constexpr char kChromeOSInfoStr[] = "X11; CrOS x86_64 14541.0.0";
+  bool spoof_as_chromeos = base::FeatureList::IsEnabled(
+      blink::features::kAndroidDesktopUASpoofAsChromeOS);
+
+  blink::UserAgentMetadata metadata =
+      embedder_support::GetUserAgentMetadata();
+  blink::UserAgentOverride spoofed_ua;
+  spoofed_ua.ua_string_override =
+      embedder_support::BuildUserAgentFromOSAndProduct(
+          enhanced_desktop
+              ? kWindowsInfoStr
+              : (spoof_as_chromeos ? kChromeOSInfoStr : kLinuxInfoStr),
+          embedder_support::GetProductAndVersion());
+  spoofed_ua.ua_metadata_override = metadata;
+  spoofed_ua.ua_metadata_override->platform =
+      enhanced_desktop
+          ? "Windows"
+          : base::FeatureList::IsEnabled(
+                blink::features::kAndroidDesktopUAPlatform)
+                ? "Android"
+                : (spoof_as_chromeos ? "Chrome OS" : "Linux");
+  spoofed_ua.ua_metadata_override->platform_version =
+      enhanced_desktop ? "10.0.0" : std::string();
+  spoofed_ua.ua_metadata_override->model = std::string();
+  spoofed_ua.ua_metadata_override->mobile = false;
+  spoofed_ua.ua_metadata_override->form_factors =
+      embedder_support::GetFormFactorsClientHint(metadata,
+                                                 /*is_mobile=*/false);
+  spoofed_ua.ua_metadata_override->architecture = "x86";
+  spoofed_ua.ua_metadata_override->bitness = "64";
+  spoofed_ua.ua_metadata_override->wow64 = false;
+  return spoofed_ua;
+}
